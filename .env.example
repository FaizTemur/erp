# Copy this file to .env and fill in real values for local development.
# On Netlify, set these same variables in Site Settings > Environment Variables instead -
# Netlify does NOT read this .env file, it's for local `npm start` only.

# From https://turso.tech - create a database, then run:
#   turso db show your-db-name --url
#   turso db tokens create your-db-name
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-token-here

# Any long random string - used to sign login sessions (JWTs)
JWT_SECRET=change-this-to-a-long-random-string

# Only needed if you want to test landlord document uploads locally
# (outside `netlify dev`). Find these in Netlify Site Settings > General.
# NETLIFY_SITE_ID=
# NETLIFY_BLOBS_TOKEN=
